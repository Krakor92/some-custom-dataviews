{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ESNext",
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "strictNullChecks": true,
    "lib": ["DOM", "ESNext"],
    "paths": {
      "@/*": ["src/*"]
    },
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "sourceMap": true,
    "types": ["obsidian-typings"]
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "**/*.svelte*",
  ]
}
